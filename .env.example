# Copy this file to `.env` and adjust. Every value is optional: the three
# bundled adapters default to public practice sites and their public demo logins.
# For a real project, never commit credentials: keep them in `.env` (git-ignored)
# locally and in GitHub Actions secrets in CI.

# Which environment file to layer on top of `.env` (loads `.env.<TEST_ENV>` if present)
TEST_ENV=demo

# Comma-separated browsers for UI adapters: chromium, firefox, webkit
BROWSERS=chromium

# Fixed seed for generated test data. Leave empty for a random seed (it is logged).
FAKER_SEED=

# --- saucedemo adapter (UI) ---
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# --- restful-booker adapter (API) ---
RESTFUL_BOOKER_BASE_URL=https://restful-booker.herokuapp.com
RESTFUL_BOOKER_USERNAME=admin
RESTFUL_BOOKER_PASSWORD=password123

# --- odoo adapter (ERP UI) ---
# With the public demo no login is needed. For your own Odoo, set all three.
ODOO_BASE_URL=https://demo.odoo.com
ODOO_USERNAME=
ODOO_PASSWORD=
