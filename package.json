{
  "name": "qa-automation-framework",
  "version": "1.0.0",
  "description": "Reusable Playwright + TypeScript QA automation framework: one shared core, one small adapter per application under test.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --grep-invert @visual",
    "test:all": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:saucedemo": "playwright test --project=\"saucedemo*\"",
    "test:restful-booker": "playwright test --project=\"restful-booker*\"",
    "test:odoo": "playwright test --project=\"odoo*\"",
    "test:core": "playwright test --project=core-selftest",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "new:adapter": "node scripts/new-adapter.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "test-automation",
    "e2e",
    "api-testing",
    "accessibility",
    "visual-regression"
  ],
  "author": "Abdulaziz",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
